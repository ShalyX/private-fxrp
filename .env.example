COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Optional safety pin. When set, it must match the FXRP resolved on-chain.
FXRP_ADDRESS=
POLICY_ISSUER_ADDRESS=
TEE_SIGNER_ADDRESS=
# Optional safety pin; deployment derives this commitment from the JSON.
POLICY_RULES_HASH=
POLICY_RULES_JSON={"allowedJurisdictions":["GB","NG"],"minimumInvestorCategory":2,"maximumRiskScore":40,"limitByCategory":{"2":"25000000000","3":"100000000000"}}
POLICY_SALT=private-fxrp-vault-v1
MAX_PRICE_AGE_SECONDS=120
FLARE_TEE_MANAGER_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
FLARE_CONTRACTS_REGISTRY_ADDRESS=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
FTSOV2_ADDRESS=0xC4e9c78EA53db782E28f28Fdf80BaF59336B304d
PREFLIGHT_OUTPUT=deployments/coston2-preflight.json
DEPLOYMENT_OUTPUT=deployments/coston2.json
EVIDENCE_OUTPUT=evidence/coston2.json
WEB_ENV_OUTPUT=web/.env.local
INSTRUCTION_FEE_WEI=0
DEPLOYMENT_GAS_BUDGET=8000000
